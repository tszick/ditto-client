{
  "name": "ditto-client",
  "version": "1.1.3",
  "description": "Node.js client for the Ditto distributed cache (TCP binary + HTTP REST)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "test:integration": "tsc && node --test tests/*.test.mjs",
    "prepublishOnly": "tsc"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
